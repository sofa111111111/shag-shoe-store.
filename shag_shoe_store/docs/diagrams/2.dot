digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.28", ranksep="0.42", splines=ortho, labelloc="t", labeljust="c", fontsize=18, fontname="Arial", label="Запуск приложения и подключение к БД"];
node [fontname="Arial", fontsize=10, color="#222222", fontcolor="#111111", penwidth=1.2, margin="0.13,0.09", style="filled", fillcolor="white"];
edge [fontname="Arial", fontsize=9, color="#222222", fontcolor="#111111", penwidth=1.1, arrowsize=0.7];
s [label="Начало", shape=ellipse];
cfg [label="Загрузить настройки приложения", shape=box];
db [label="Подключиться к MySQL", shape=box];
q [label="Подключение успешно?", shape=diamond];
login [label="Открыть окно входа", shape=box];
err [label="Показать сообщение о проблеме подключения", shape=box];
retry [label="Повторить подключение?", shape=diamond];
e [label="Конец", shape=ellipse];
s -> cfg [];
cfg -> db [];
db -> q [];
q -> login [label="Да"];
q -> err [label="Нет"];
login -> e [];
err -> retry [];
retry -> db [label="Да"];
retry -> e [label="Нет"];
}
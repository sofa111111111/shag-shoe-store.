digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.28", ranksep="0.42", splines=ortho, labelloc="t", labeljust="c", fontsize=18, fontname="Arial", label="Общая схема работы информационной системы магазина обуви"];
node [fontname="Arial", fontsize=10, color="#222222", fontcolor="#111111", penwidth=1.2, margin="0.13,0.09", style="filled", fillcolor="white"];
edge [fontname="Arial", fontsize=9, color="#222222", fontcolor="#111111", penwidth=1.1, arrowsize=0.7];
s [label="Начало", shape=ellipse];
start [label="Запуск приложения и подключение к БД (D02)", shape=box];
login [label="Авторизация и определение роли (D03)", shape=box];
role [label="Роль пользователя?", shape=diamond];
guest [label="Гость: просмотр каталога (D05)", shape=box];
client [label="Клиент: просмотр каталога (D05)", shape=box];
manager [label="Менеджер: поиск, фильтр, сортировка, заказы (D06)", shape=box];
admin [label="Администратор: управление товарами и заказами (D07–D10)", shape=box];
nav [label="Навигация между окнами (D04)", shape=box];
msg [label="Обработка ошибок и сообщений (D11)", shape=box];
logout [label="Выход из системы", shape=box];
e [label="Конец", shape=ellipse];
s -> start [];
start -> login [];
login -> role [];
role -> guest [label="Гость"];
role -> client [label="Клиент"];
role -> manager [label="Менеджер"];
role -> admin [label="Администратор"];
guest -> nav [];
client -> nav [];
manager -> nav [];
admin -> nav [];
nav -> msg [];
msg -> logout [];
logout -> e [];
}
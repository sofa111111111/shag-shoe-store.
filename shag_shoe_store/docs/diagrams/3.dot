digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.28", ranksep="0.42", splines=ortho, labelloc="t", labeljust="c", fontsize=18, fontname="Arial", label="Авторизация и определение роли"];
node [fontname="Arial", fontsize=10, color="#222222", fontcolor="#111111", penwidth=1.2, margin="0.13,0.09", style="filled", fillcolor="white"];
edge [fontname="Arial", fontsize=9, color="#222222", fontcolor="#111111", penwidth=1.1, arrowsize=0.7];
s [label="Начало", shape=ellipse];
screen [label="Показать окно входа", shape=box];
guest [label="Выбран вход гостем?", shape=diamond];
guestcat [label="Открыть каталог только для просмотра", shape=box];
input [label="Ввести логин и пароль", shape=parallelogram];
check [label="Проверить учётные данные в БД", shape=box];
valid [label="Данные верны?", shape=diamond];
role [label="Определить роль и показать ФИО", shape=box];
ui [label="Открыть интерфейс роли", shape=box];
err [label="Показать ошибку авторизации", shape=box];
e [label="Конец", shape=ellipse];
s -> screen [];
screen -> guest [];
guest -> guestcat [label="Да"];
guest -> input [label="Нет"];
guestcat -> e [];
input -> check [];
check -> valid [];
valid -> role [label="Да"];
valid -> err [label="Нет"];
role -> ui [];
ui -> e [];
err -> input [label="Повторить ввод"];
}
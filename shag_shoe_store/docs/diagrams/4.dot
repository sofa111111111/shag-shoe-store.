digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.28", ranksep="0.42", splines=ortho, labelloc="t", labeljust="c", fontsize=18, fontname="Arial", label="Навигация между окнами"];
node [fontname="Arial", fontsize=10, color="#222222", fontcolor="#111111", penwidth=1.2, margin="0.13,0.09", style="filled", fillcolor="white"];
edge [fontname="Arial", fontsize=9, color="#222222", fontcolor="#111111", penwidth=1.1, arrowsize=0.7];
s [label="Начало: открыт каталог", shape=ellipse];
act [label="Пользователь выбирает пункт меню или кнопку", shape=parallelogram];
perm [label="Проверить права доступа", shape=box];
allowed [label="Доступ разрешён?", shape=diamond];
deny [label="Показать сообщение о запрете", shape=box];
open [label="Открыть окно с нужным заголовком", shape=box];
back [label="Нажата кнопка «Назад»?", shape=diamond];
prev [label="Вернуться на предыдущее окно", shape=box];
logout [label="Нажата кнопка «Выйти»?", shape=diamond];
login [label="Вернуться к окну входа", shape=box];
e [label="Конец", shape=ellipse];
s -> act [];
act -> perm [];
perm -> allowed [];
allowed -> deny [label="Нет"];
allowed -> open [label="Да"];
deny -> e [];
open -> back [];
back -> prev [label="Да"];
back -> logout [label="Нет"];
prev -> e [];
logout -> login [label="Да"];
logout -> e [label="Нет"];
}